# 你的域名，DNS 需已指向这台服务器；Caddy 会自动申请 HTTPS 证书
OWNMIND_DOMAIN=ownmind.example.com

# 镜像版本：edge = main 分支最新构建；发布后可改成 v0.1.0 这样的固定版本
OWNMIND_IMAGE=ghcr.io/skadli/ownmind:edge
OWNMIND_SANDBOX_IMAGE=ghcr.io/skadli/ownmind-sandbox:edge

# 沙盒（agent 执行命令的容器）资源上限
OWNMIND_SANDBOX_CPUS=1.0
OWNMIND_SANDBOX_MEMORY=1g

# 日志级别
RUST_LOG=info
